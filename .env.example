# ==========================================
# Feishu App Credentials
# Get from: https://open.feishu.cn/app (App Settings > Credentials)
# ==========================================
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# DeepSeek API Key (for non-exec chat messages)
# Get from: https://platform.deepseek.com/api_keys
# ==========================================
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Optional Settings
# ==========================================
# Claude CLI command (uses npm global claude by default)
# CLAUDE_PATH=claude

# Claude task timeout in seconds (default: 300)
# CLAUDE_TIMEOUT=300

# Idle session lifetime in seconds (default: 1800 = 30 min)
# SESSION_IDLE_TIMEOUT=1800

# Claude permission mode: bypassPermissions | acceptEdits | default
# bypassPermissions = full auto-approval (recommended for personal use)
# PERMISSION_MODE=bypassPermissions

# Max concurrent Claude subprocesses (default: 3)
# MAX_CONCURRENT_CLAUDE=3
